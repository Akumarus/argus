{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD debug stm32f103",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "executable": "${workspaceFolder}/build/Debug/argus.elf",
            "request": "launch",
            "servertype": "openocd",
            "interface": "swd",
            "serialNumber": "",
            "runToEntryPoint": "main",
            "svdFile": "STM32F103.svd",
            "device": "STM32F103CB",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 1
            },
            "configFiles": [
                "interface/stlink-v2.cfg",
                "target/stm32f1x.cfg"
            ]
        }
    ]
}